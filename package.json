{
  "name": "gulp-starter",
  "version": "1.0.0",
  "description": "Мощная Gulp-сборка: SCSS, JS, WebP/AVIF, critical CSS, SEO",
  "scripts": {
    "dev": "gulp",
    "build": "cross-env NODE_ENV=production gulp build",
    "clean": "gulp clean",
    "clean:all": "gulp clean:all",
    "lint": "eslint src/js/**/*.js && stylelint \"src/scss/**/*.scss\"",
    "lint:js": "eslint src/js/**/*.js",
    "lint:scss": "stylelint \"src/scss/**/*.scss\"",
    "lint:fix": "eslint src/js/**/*.js --fix && stylelint \"src/scss/**/*.scss\" --fix",
    "analyze": "gulp analyze",
    "prepare": "husky"
  },
  "keywords": [
    "gulp",
    "scss",
    "esbuild",
    "critical-css",
    "webp",
    "avif"
  ],
  "author": "Timur Vetrov <https://github.com/VetrovTimur>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VetrovTimur/gulp-starter-public.git"
  },
  "homepage": "https://github.com/VetrovTimur/gulp-starter-public#readme",
  "lint-staged": {
    "src/js/**/*.js": "eslint --fix",
    "src/scss/**/*.scss": "stylelint --fix"
  },
  "type": "commonjs",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "critical": "^9.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.12.0",
    "favicons": "^7.3.1",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-esbuild": "^0.15.0",
    "gulp-file-include": "^2.3.0",
    "gulp-htmlmin": "^5.0.1",
    "gulp-notify": "^5.0.0",
    "gulp-plumber": "^1.2.1",
    "gulp-rename": "^2.1.0",
    "gulp-rev": "^12.0.0",
    "gulp-rev-rewrite": "^7.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-sharp-responsive": "^0.4.1",
    "gulp-sitemap": "^8.0.0",
    "gulp-size": "^5.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-svg-sprite": "^2.0.3",
    "gulp-svgo": "^3.0.1",
    "html-validate": "^11.16.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ttf2woff": "^3.0.0",
    "ttf2woff2": "^8.0.1"
  }
}
